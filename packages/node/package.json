{
  "name": "@ironsheet/node",
  "version": "0.2.0",
  "type": "module",
  "description": "Node.js IO, compression, and safe-write adapter for Ironsheet workbooks.",
  "license": "Apache-2.0",
  "author": "Ironsheet contributors",
  "homepage": "https://ironsheetdocs.vercel.app",
  "bugs": "https://github.com/btahir/ironsheet/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btahir/ironsheet.git",
    "directory": "packages/node"
  },
  "keywords": [
    "excel",
    "xlsx",
    "xlsm",
    "ooxml",
    "spreadsheet",
    "template",
    "lossless",
    "typescript",
    "node"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@ironsheet/core": "0.2.0"
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
