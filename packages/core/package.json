{
  "name": "@ironsheet/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Lossless TypeScript OOXML workbook engine for editing real XLSX and XLSM files.",
  "license": "Apache-2.0",
  "author": "Ironsheet contributors",
  "homepage": "https://github.com/btahir/ironsheet#readme",
  "bugs": "https://github.com/btahir/ironsheet/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btahir/ironsheet.git",
    "directory": "packages/core"
  },
  "keywords": [
    "excel",
    "xlsx",
    "xlsm",
    "ooxml",
    "spreadsheet",
    "template",
    "lossless",
    "typescript",
    "workbook"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src"],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
