{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "dist",
    "paths": {
      "@ironsheet/core": ["packages/core/dist/index.d.ts"],
      "@ironsheet/node": ["packages/node/dist/index.d.ts"]
    },
    "rootDir": "src",
    "sourceMap": true,
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts"]
}
