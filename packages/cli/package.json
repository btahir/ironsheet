{
  "name": "@ironsheet/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Safe command-line workbook inspection, validation, and XLSX/XLSM edits for Ironsheet.",
  "license": "Apache-2.0",
  "author": "Ironsheet contributors",
  "homepage": "https://github.com/btahir/ironsheet#readme",
  "bugs": "https://github.com/btahir/ironsheet/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/btahir/ironsheet.git",
    "directory": "packages/cli"
  },
  "keywords": ["excel", "xlsx", "xlsm", "ooxml", "spreadsheet", "template", "lossless", "cli"],
  "main": "./dist/cli.js",
  "types": "./dist/cli.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cli.d.ts",
      "default": "./dist/cli.js"
    }
  },
  "bin": {
    "ironsheet": "dist/cli.js"
  },
  "dependencies": {
    "@ironsheet/core": "0.1.0",
    "@ironsheet/node": "0.1.0"
  },
  "files": ["dist", "src"],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
