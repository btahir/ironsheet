{
  "name": "ironsheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Move fast and break no spreadsheets.",
  "scripts": {
    "verify": "tsx scripts/verify.ts",
    "commit:safe": "tsx scripts/commit-safe.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "cli": "tsx packages/cli/src/cli.ts",
    "compat:check": "tsx scripts/compat.ts",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
