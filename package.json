{
  "name": "ironsheet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Move fast and break no spreadsheets.",
  "workspaces": ["packages/*"],
  "scripts": {
    "ci": "npm run verify && npm run compat:corpus",
    "verify": "tsx scripts/verify.ts",
    "commit:safe": "tsx scripts/commit-safe.ts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "build": "tsx scripts/build.ts",
    "pack:check": "npm run build && npm pack --workspaces --dry-run",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "runtime:check": "tsx scripts/runtime-check.ts",
    "cli": "tsx packages/cli/src/cli.ts",
    "compat:check": "tsx scripts/compat.ts",
    "compat:fixtures": "tsx scripts/build-compat-fixtures.ts",
    "compat:corpus": "npm run compat:fixtures && tsx scripts/compat-corpus.ts",
    "compat:corpus:strict": "npm run compat:fixtures && tsx scripts/compat-corpus.ts --strict",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^25.6.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=18"
  }
}
